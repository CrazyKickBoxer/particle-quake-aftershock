    if(id>=pc.gridCapacity || cells[id].key==INVALID) return;
    vec3 normal=vec3(cells[id].nx,cells[id].ny,cells[id].nz);
    if(dot(normal,normal)<1.) normal=unpackSnorm4x8(floatBitsToUint(homes[cells[id].point].w)).xyz;
    normal=safeNormal(normal);cells[id].normal=packSnorm4x8(vec4(normal,0));
    uint key=cells[id].key;
    vec3 center=(vec3(key&1023u,(key>>10u)&1023u,(key>>20u)&1023u)+.5)*pc.gridOriginCell.w+pc.gridOriginCell.xyz;
    cells[id].distance=packHalf2x16(vec2(dot(center-homes[cells[id].point].xyz,normal),0));
