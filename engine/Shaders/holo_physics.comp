        float score=clamp(p.freeTimer/max(.05,p.freeLifetime),0.,1.);
        if((p.flags&64u)!=0u) score*=1.5;
        if(score>best) { best=score;winner=slot; }
    }
    lightScores[id]=best;lightWinners[id]=winner;barrier();
    if(id>=4u) return;
    for(uint i=id+4u;i<64u;i+=4u) if(lightScores[i]>best) { best=lightScores[i];winner=lightWinners[i]; }
    Light light;light.origin=vec3(0);light.radius=0.;light.color=vec3(0);light.minlight=0.;light.cone=vec3(0);light.coneCos=-2.;
    if(winner!=INVALID) { Particle p=particles[winner];light.origin=p.position;
        light.radius=64.*best;light.color=holoPalette(int(words[15]),(p.flags&GORE)!=0u?3:1,vec3(.5))*best;
    }
    lights[id]=light;
#elif HP_PASS == 14
    // Draw-only expiry/compaction. STUCK particles are never integrated.
    if(id==0u) words[28]=floatBitsToUint(pc.goreLife);
    if(id>=65536u) return;
    if(pc.goreEnabled==0u || id>=pc.goreCap) { stains[id].flags=0u;return; }
    Particle p=stains[id];if((p.flags&STUCK)==0u) return;
    if(pc.time-p.freeTimer>=pc.goreLife) { stains[id].flags=0u;return; }
