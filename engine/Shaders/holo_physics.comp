    p.velocity=safeNormal(random+vec3(0,0,.5))*e.strength+e.direction*e.strength*.5;
    p.freeTimer=3.;p.flags=FREE|GORE;p.seed=seed;p.freeLifetime=3.;p.sourceRef=INVALID;
    if(e.type==4u || e.type==5u) {
        float angle=float(gl_LocalInvocationID.x)/64.*6.283185;
        vec3 radial=vec3(cos(angle),sin(angle),0);
        p.position=e.origin+radial*(e.type==4u?12.:e.radius*.5);
        p.velocity=(radial*(e.type==4u?1.:-1.)+vec3(0,0,e.type==4u?1.5:.2))*e.strength;
