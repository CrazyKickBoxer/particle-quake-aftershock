layout(push_constant) uniform Settings {
    uint budget; uint sourceCount; uint eventCount; uint inputList;
    float dt; float time; float settle; float turbulence;
    float suction; float gravity; float epsilonPosition; float epsilonSpeed;
    float sprayCount; float pointStep; float pad0; float pad1;
    vec4 gridOriginCell;
    uint gridCapacity; uint collide; float restitution; float turbulenceScale;
    uint goreCap; uint goreEnabled; float goreLife; float goreGravity;
    float dust; float beamCrawl; float deathEnabled; float shake;
} pc;
const uint FREE=1u, STUCK=2u, GORE=4u, DEBRIS=8u, DUST=16u, SPARK=32u;
// Bits 8-10 are the colour slot, 64/128 are core/death, so 2048 is the first free bit.
const uint BOUNCED=2048u;
const uint INVALID=0xffffffffu;
uint inputBase() { return 128u+pc.inputList*pc.budget; }
uint outputBase() { return 128u+(1u-pc.inputList)*pc.budget; }
uint freeBase() { return 128u+2u*pc.budget; }
uint hashId(uint x) { x^=x>>16; x*=0x7feb352du; x^=x>>15; x*=0x846ca68bu; return x^(x>>16); }
uint cellKey(vec3 p) {
    ivec3 c=ivec3(floor((p-pc.gridOriginCell.xyz)/pc.gridOriginCell.w));
    if(any(lessThan(c,ivec3(0))) || any(greaterThanEqual(c,ivec3(1024)))) return 0xffffffffu;
    return uint(c.x)|(uint(c.y)<<10u)|(uint(c.z)<<20u);
}
uint cellFind(uint key) {
    if(key==0xffffffffu) return 0xffffffffu;
    for(uint i=0u;i<32u;++i) { uint h=(hashId(key)+i)%pc.gridCapacity;
        uint found=cells[h].key; if(found==key) return h; if(found==0xffffffffu) break; }
    return 0xffffffffu;
}
bool collideSurface(vec3 previous,inout vec3 position,inout vec3 velocity) {
    if(pc.collide==0u) return false;
