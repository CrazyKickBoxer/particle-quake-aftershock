    particles[slot]=p;appendActive(slot);atomicAdd(words[8],1u);
#elif HP_PASS == 11
    DeathJob job=deathJobs[uint(pc.pad1)];
    uint count=min(job.info.x,pc.budget/8u);
    vec3 eye=vec3(uintBitsToFloat(words[24]),uintBitsToFloat(words[25]),uintBitsToFloat(words[26]));
    float lod=clamp(384./max(384.,distance(job.model[3].xyz,eye)),.1,1.);
    count=max(1u,uint(float(count)*lod*lod));
