}
vec3 safeNormal(vec3 v) { float d=dot(v,v); return d>1e-12?v*inversesqrt(d):vec3(0,0,1); }
vec3 curlWind(vec3 position) {
    vec3 q=position/max(8.,pc.turbulenceScale)+pc.time*vec3(.25,.3,.2);
    return vec3(cos(q.y)-sin(q.z),cos(q.z)-sin(q.x),cos(q.x)-sin(q.y));
}
uint popFree() {
    uint n=atomicAdd(words[2],0u);
    for(uint retry=0u;retry<64u && n!=0u;++retry) { uint prior=atomicCompSwap(words[2],n,n-1u);
        if(prior==n) return words[freeBase()+n-1u]; n=prior; }
    return INVALID;
}
void retire(Particle p,uint slot) {
    if(p.pointId!=INVALID) {
        atomicAnd(bits[p.pointId>>5],~(1u<<(p.pointId&31u)));
        lookup[p.sourceRef]=uvec2(0xfffffffeu,INVALID);
    }
    particles[slot].flags=0u;
    uint n=atomicAdd(words[2],1u); words[freeBase()+n]=slot;
}
void appendActive(uint slot) {
    uint n=atomicAdd(words[1u-pc.inputList],1u);
    words[outputBase()+n]=slot;
}
void spring(inout vec3 x,inout vec3 v,float omega,float dt) {
    vec3 c=v+omega*x; float decay=exp(-omega*dt);
    x=(x+c*dt)*decay; v=(v-omega*c*dt)*decay;
}
