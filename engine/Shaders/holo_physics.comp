    uint slot=popFree();if(slot==INVALID) { atomicAdd(words[3],1u);return; }
    uint sampleId=min(job.info.x-1u,id*job.info.x/max(1u,count));
    uint base=job.mesh.w+sampleId*4u;
    uvec3 ids=uvec3(mesh[base],mesh[base+1u],mesh[base+2u]);uint packed=mesh[base+3u];
    vec2 bary=vec2(packed&4095u,(packed>>12u)&4095u)/4095.;
    vec3 weights=vec3(1.-bary.x-bary.y,bary);
    vec3 local=vec3(0);
    for(int j=0;j<3;++j) local+=mix(meshPosition(job.mesh.x,ids[j]),meshPosition(job.mesh.y,ids[j]),job.parameters.x)*weights[j];
    vec3 world=(job.model*vec4(local,1)).xyz;
    vec3 center=job.model[3].xyz;
    uint seed=hashId(id^job.info.y);
    vec3 random=vec3(float(hashId(seed)&65535u),float(hashId(seed+1u)&65535u),float(hashId(seed+2u)&65535u))/32767.5-1.;
    bool core=id>=count;
    if(core) world=center+vec3(0,0,20)+random*4.;
    Particle p;p.position=world;p.pointId=INVALID;
    p.velocity=(safeNormal(world-center+random*6.)+vec3(0,0,.6))*job.parameters.y;
    if(core) p.velocity=-random*4.;
    p.freeTimer=job.parameters.z+(core?.35:0.);p.flags=FREE|DEBRIS|128u|(core?64u:0u);
    p.seed=seed;p.freeLifetime=p.freeTimer;p.sourceRef=INVALID;
    particles[slot]=p;appendActive(slot);atomicAdd(words[8],1u);
#elif HP_PASS == 12
    float best=0.;uint winner=INVALID;
    for(uint i=id;i<words[1u-pc.inputList];i+=64u) {
        uint slot=words[outputBase()+i];Particle p=particles[slot];
