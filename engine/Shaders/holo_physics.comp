    int steps=clamp(int(ceil(length(travel)/(pc.gridOriginCell.w*.4))),1,8);
    for(int i=1;i<=steps;++i) {
        vec3 samplePosition=previous+travel*(float(i)/float(steps));
        uint cell=cellFind(cellKey(samplePosition)); if(cell==0xffffffffu) continue;
        uint point=cells[cell].point; if(point>=pc.sourceCount) continue;
        vec3 normal=normalize(unpackSnorm4x8(cells[cell].normal).xyz);
        uint key=cells[cell].key;
        vec3 center=(vec3(key&1023u,(key>>10u)&1023u,(key>>20u)&1023u)+.5)*pc.gridOriginCell.w+pc.gridOriginCell.xyz;
        float planeDistance=unpackHalf2x16(cells[cell].distance).x;
        float before=dot(previous-center,normal)+planeDistance,after=dot(samplePosition-center,normal)+planeDistance;
        if(dot(travel,normal)<0.0 && before>=-.5 && after<.2) {
