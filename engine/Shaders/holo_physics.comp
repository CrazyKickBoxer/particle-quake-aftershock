        if(e.type==3u || e.type==6u) { lo=min(e.origin,e.direction)-vec3(e.radius);hi=max(e.origin,e.direction)+vec3(e.radius); }
        if(all(lessThanEqual(lo,face.maxs.xyz)) && all(greaterThanEqual(hi,face.mins.xyz))) { affected=true;break; }
    }
    if(!affected) return;
    uint base=atomicAdd(words[112],face.range.w);
    for(uint i=0u;i<face.range.w;++i) words[128u+3u*pc.budget+65536u+base+i]=face.range.z+i;
